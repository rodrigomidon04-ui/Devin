# Copiá este archivo como .env y completá los valores de tu proyecto de Supabase.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Opcionales: personalizan el encabezado de la página.
VITE_SITE_TITLE=Mi Portfolio
VITE_SITE_SUBTITLE=Imágenes, textos y enlaces de mis proyectos, todo en un solo lugar.
