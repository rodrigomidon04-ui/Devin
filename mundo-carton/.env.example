# Copia este archivo como .env y completá los datos de tu proyecto.

# Supabase (si los dejás vacíos, la página abre en MODO DEMO).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Teléfono de WhatsApp donde llegan los pedidos de la tienda.
# Solo números, con código de país y sin el signo +. Ejemplo Uruguay: 59899123456
VITE_WHATSAPP_NUMBER=59899123456

# Opcionales: textos del encabezado.
VITE_SITE_TITLE=Mundo Cartón
VITE_SITE_SUBTITLE=Videos para aprender a construir con cartón reciclado y una tienda de juguetes y muebles para chicos.
